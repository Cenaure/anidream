{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@spartan-ng/helm/card": [
        "./src/app/shared/ui/card/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./src/app/shared/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./src/app/shared/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./src/app/shared/ui/input/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./src/app/shared/ui/label/src/index.ts"
      ],
      "@spartan-ng/helm/sonner": [
        "./src/app/shared/ui/sonner/src/index.ts"
      ],
      "@spartan-ng/helm/table": [
        "./src/app/shared/ui/table/src/index.ts"
      ],
      "@spartan-ng/helm/dropdown-menu": [
        "./src/app/shared/ui/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "./src/app/shared/ui/icon/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "./src/app/shared/ui/select/src/index.ts"
      ],
      "@spartan-ng/helm/typography": [
        "./src/app/shared/ui/typography/src/index.ts"
      ],
      "@spartan-ng/helm/alert-dialog": [
        "./src/app/shared/ui/alert-dialog/src/index.ts"
      ],
      "@spartan-ng/helm/switch": [
        "./src/app/shared/ui/switch/src/index.ts"
      ],
      "@spartan-ng/helm/checkbox": [
        "./src/app/shared/ui/checkbox/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [
    "src/main.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
